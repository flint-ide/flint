// Place your key bindings in this file to override the defaults
[
	{ "key": "cmd+shift+a", "command": "workbench.action.showCommands" },
	{ "key": "cmd+t", "command": "workbench.action.quickOpen" },
	{ "key": "cmd+e", "command": "workbench.action.quickOpen" },
	{ "key": "ctrl+`", "command": "workbench.action.terminal.toggleTerminal" },
	{ "key": "cmd+k cmd+t", "command": "workbench.action.selectTheme" },
	{ "key": "cmd+k cmd+p", "command": "git.push" },
	{ "key": "cmd+j", "command": "-workbench.action.togglePanel" },
	{ "key": "cmd+enter", "command": "git.commit", "when": "scmRepository" },
	{ "key": "f5", "command": "workbench.action.debug.start" },
	{ "key": "cmd+i", "command": "workbench.action.terminal.sendSequence", "args": { "text": "ls\n" } },
	{ "key": "cmd+shift+d", "command": "editor.action.copyLinesDownAction" },
	{ "key": "x", "command": "workbench.action.toggleSidebarVisibility" },
	{ "key": "cmd+b", "command": "workbench.action.toggleSidebarVisibility" },
]
