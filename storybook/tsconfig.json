{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@flint-ide/ui": ["../ui/src/index.ts"],
      "@flint-ide/ui/icons": ["../ui/src/icons.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": [".storybook", "stories", "env.d.ts"]
}
